<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trilha do Conhecimento: Gestão de Estoques</title>
  <style>
    /* ==========================================================================
       1. PALETA DE CORES E VARIÁVEIS CSS (Glassmorphism & Corporate Clean)
       ========================================================================== */
    :root {
      --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311b92 100%);
      --glass-bg: rgba(30, 41, 59, 0.65);
      --glass-border: rgba(255, 255, 255, 0.12);
      --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
      
      --color-primary: #8b5cf6;       
      --color-primary-hover: #7c3aed;
      --color-secondary: #06b6d4;     
      --color-accent: #f59e0b;        
      --color-success: #10b981;       
      --color-danger: #ef4444;        
      --color-text-main: #f8fafc;     
      --color-text-muted: #94a3b8;    
      
      --font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      --border-radius-lg: 24px;
      --border-radius-md: 16px;
      --border-radius-sm: 10px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: var(--font-family);
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: var(--bg-gradient);
      background-attachment: fixed;
      color: var(--color-text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-bottom: 40px;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: radial-gradient(circle at 20% 20%, rgba(139, 92, 246, 0.15) 0%, transparent 40%),
                  radial-gradient(circle at 80% 80%, rgba(6, 182, 212, 0.15) 0%, transparent 40%);
      pointer-events: none;
      z-index: 0;
    }

    .container {
      width: 100%;
      max-width: 850px;
      padding: 20px;
      position: relative;
      z-index: 1;
    }

    /* ==========================================================================
       2. COMPONENTES GLASSMORPHISM & HUD
       ========================================================================== */
    .glass-card {
      background: var(--glass-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
      border-radius: var(--border-radius-lg);
      padding: 32px;
      margin-bottom: 24px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    #hud {
      position: sticky;
      top: 12px;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 20px;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border: 1px solid var(--glass-border);
      border-radius: var(--border-radius-md);
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
      margin-bottom: 24px;
    }

    .hud-item { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.95rem; }
    .hud-badge { background: rgba(255,255,255,0.1); padding: 4px 12px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); }
    .hud-vacilos { color: var(--color-danger); }

    .btn-teacher-reset {
      background: transparent; border: none; cursor: pointer; font-size: 1.1rem; opacity: 0.4; transition: opacity 0.2s;
    }
    .btn-teacher-reset:hover { opacity: 1.0; }

    /* ==========================================================================
       3. BOTÕES E ELEMENTOS INTERATIVOS
       ========================================================================== */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      width: 100%; padding: 16px 24px; border: none; border-radius: var(--border-radius-md);
      background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
      color: white; font-size: 1.05rem; font-weight: 700; cursor: pointer;
      box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4); transition: all 0.2s ease;
    }

    .btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(139, 92, 246, 0.6); }
    .btn:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; transform: none; }

    .input-text {
      width: 100%; padding: 16px; background: rgba(0, 0, 0, 0.25);
      border: 2px solid var(--glass-border); border-radius: var(--border-radius-md);
      color: white; font-size: 1rem; outline: none; transition: border-color 0.2s; margin-bottom: 20px;
    }
    .input-text:focus { border-color: var(--color-secondary); }
    textarea.input-text { min-height: 160px; resize: vertical; line-height: 1.6; }

    /* ==========================================================================
       4. MAPA DA TRILHA
       ========================================================================== */
    .trail-map { display: flex; flex-direction: column; align-items: center; gap: 40px; padding: 20px 0; position: relative; }
    .node-wrapper { display: flex; flex-direction: column; align-items: center; position: relative; z-index: 2; width: 100%; }
    
    .node-btn {
      width: 90px; height: 90px; border-radius: 50%; border: 4px solid rgba(255,255,255,0.2);
      display: flex; align-items: center; justify-content: center; font-size: 2.2rem; cursor: pointer;
      background: var(--glass-bg); box-shadow: 0 8px 25px rgba(0,0,0,0.5); transition: all 0.3s ease; position: relative;
    }

    .node-btn.locked { background: rgba(51, 65, 85, 0.8); border-color: rgba(255,255,255,0.05); cursor: not-allowed; opacity: 0.6; }
    .node-btn.current { background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border-color: #ffffff; transform: scale(1.15); box-shadow: 0 0 30px rgba(6, 182, 212, 0.8); animation: pulse 2s infinite; }
    .node-btn.completed { background: var(--color-success); border-color: #a7f3d0; }

    @keyframes pulse {
      0% { transform: scale(1.1); box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.7); }
      70% { transform: scale(1.18); box-shadow: 0 0 0 15px rgba(6, 182, 212, 0); }
      100% { transform: scale(1.1); box-shadow: 0 0 0 0 rgba(6, 182, 212, 0); }
    }

    .node-label {
      margin-top: 12px; font-weight: 700; font-size: 1rem; text-align: center;
      background: rgba(0,0,0,0.4); padding: 8px 16px; border-radius: 20px; border: 1px solid var(--glass-border);
    }

    .node-connector { position: absolute; width: 6px; background: rgba(255,255,255,0.15); top: 90px; height: 40px; z-index: 1; }
    .node-connector.active { background: linear-gradient(to bottom, var(--color-success), var(--color-primary)); }
    .node-wrapper:nth-child(odd) { transform: translateX(-40px); }
    .node-wrapper:nth-child(even) { transform: translateX(40px); }

    /* ==========================================================================
       5. PASSO A PASSO (LIÇÃO)
       ========================================================================== */
    .step-progress-bar { display: flex; gap: 10px; margin-bottom: 28px; }
    .step-dot { flex: 1; height: 8px; background: rgba(255,255,255,0.15); border-radius: 4px; transition: background 0.3s; }
    .step-dot.active { background: var(--color-secondary); }
    .step-dot.completed { background: var(--color-success); }

    .narrative-box { font-size: 1.1rem; line-height: 1.8; color: #e2e8f0; margin-bottom: 28px; text-align: justify; }
    .highlight-box {
      background: rgba(139, 92, 246, 0.15); border-left: 4px solid var(--color-primary);
      padding: 18px; border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0; margin: 24px 0; font-style: italic;
    }

    .quiz-question { font-size: 1.15rem; font-weight: 700; margin-bottom: 18px; line-height: 1.5; }
    .quiz-options { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
    
    .option-btn {
      background: rgba(255, 255, 255, 0.05); border: 2px solid var(--glass-border);
      border-radius: var(--border-radius-md); padding: 18px; color: var(--color-text-main);
      text-align: left; font-size: 1rem; cursor: pointer; transition: all 0.2s; line-height: 1.4;
    }
    .option-btn:hover:not(:disabled) { background: rgba(255, 255, 255, 0.12); border-color: var(--color-secondary); }
    .option-btn.correct { background: rgba(16, 185, 129, 0.25) !important; border-color: var(--color-success) !important; color: #a7f3d0 !important; font-weight: bold; }
    .option-btn.incorrect { background: rgba(239, 68, 68, 0.25) !important; border-color: var(--color-danger) !important; color: #fca5a5 !important; }

    .feedback-box { padding: 18px; border-radius: var(--border-radius-md); margin-bottom: 24px; font-size: 0.95rem; line-height: 1.6; }
    .feedback-box.correct { background: rgba(16, 185, 129, 0.15); border: 1px solid var(--color-success); }
    .feedback-box.incorrect { background: rgba(239, 68, 68, 0.15); border: 1px solid var(--color-danger); }

    .char-counter { text-align: right; font-size: 0.9rem; color: var(--color-text-muted); margin-top: -12px; margin-bottom: 24px; }
    .char-counter.valid { color: var(--color-success); font-weight: bold; }

    /* ==========================================================================
       6. TOAST, MODAL & IMPRESSÃO
       ========================================================================== */
    #toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 1000; display: flex; flex-direction: column; gap: 10px; max-width: 350px; }
    .toast {
      background: rgba(239, 68, 68, 0.95); color: white; padding: 16px 20px; border-radius: var(--border-radius-md);
      box-shadow: 0 10px 25px rgba(0,0,0,0.5); font-weight: 600; font-size: 0.95rem; line-height: 1.4;
      animation: slideIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); border-left: 6px solid #7f1d1d;
    }
    @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    .modal-overlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8);
      backdrop-filter: blur(8px); z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 20px;
    }

    .confetti-container { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 999; overflow: hidden; }
    .confetti { position: absolute; font-size: 1.5rem; animation: fall 3s linear infinite; }
    @keyframes fall { 0% { transform: translateY(-10vh) rotate(0deg); opacity: 1; } 100% { transform: translateY(105vh) rotate(360deg); opacity: 0; } }

    .screen { display: none; }
    .screen.active { display: block; }

    /* Estilização Oficial para Impressão do Boletim */
    @media print {
      body { background: white !important; color: #111 !important; margin: 0; padding: 0; }
      body::before { display: none; }
      #hud, .btn, #toast-container, .step-progress-bar { display: none !important; }
      .container { max-width: 100%; padding: 0; }
      .glass-card {
        background: transparent !important; border: none !important; box-shadow: none !important;
        padding: 0 !important; margin: 0 !important; color: #000 !important; backdrop-filter: none !important;
      }
      .printable-area { display: block !important; width: 100%; }
      
      /* Elementos do Relatório */
      h2, h3, h4, h5 { color: #000 !important; margin-top: 15px; }
      .print-header { border-bottom: 2px solid #000; padding-bottom: 15px; margin-bottom: 20px; text-align: center; }
      .print-summary { border: 1px solid #000; padding: 15px; margin-bottom: 25px; border-radius: 4px; }
      
      .detailed-report-section { 
        page-break-inside: avoid; 
        border: 1px solid #ccc !important; 
        padding: 15px !important; 
        margin-bottom: 20px !important; 
        background: #fdfdfd !important;
        border-radius: 4px;
      }
      .print-written-box {
        font-family: 'Courier New', Courier, monospace; 
        font-size: 10pt; 
        border-left: 3px solid #666; 
        padding: 10px; 
        background: #f4f4f4; 
        margin-top: 10px;
        white-space: pre-wrap;
      }
      .print-correct { color: #059669 !important; font-weight: bold; }
      .print-incorrect { color: #dc2626 !important; font-weight: bold; }
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- HUD FIXO -->
    <div id="hud" style="display: none;">
      <div class="hud-item"><span>👤</span> <span id="hud-user-name">Aluno</span></div>
      <div class="hud-item hud-badge"><span>⏱️</span> <span id="hud-timer">00:00</span></div>
      <div class="hud-item hud-badge hud-vacilos"><span>⚠️ Vacilos:</span> <span id="hud-vacilos-count">0</span></div>
      <button class="btn-teacher-reset" onclick="openTeacherModal()" title="Área do Professor">⚙️</button>
    </div>

    <!-- TELA A: BOAS-VINDAS -->
    <div id="screen-welcome" class="screen active">
      <div class="glass-card" style="text-align: center;">
        <h1 style="font-size: 2.2rem; margin-bottom: 12px; background: linear-gradient(to right, var(--color-primary), var(--color-secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
          Trilha do Conhecimento
        </h1>
        <p style="color: var(--color-text-muted); margin-bottom: 24px; font-size: 1.1rem;">
          Técnico em Logística — Planejamento e Controle de Estoques
        </p>

        <div style="text-align: left; background: rgba(0,0,0,0.2); padding: 20px; border-radius: var(--border-radius-md); margin-bottom: 28px; font-size: 1rem; line-height: 1.6;">
          <p style="font-weight: bold; color: var(--color-secondary); margin-bottom: 12px; font-size: 1.1rem;">📜 DIRETRIZES DA ATIVIDADE:</p>
          <ul style="margin-left: 24px; margin-bottom: 12px;">
            <li>Esta avaliação contém <strong>2 Estações Críticas</strong> de logística operacional.</li>
            <li>Seu progresso, respostas e textos são salvos no sistema automaticamente em tempo real.</li>
          </ul>
          <div style="background: rgba(239, 68, 68, 0.15); border-left: 4px solid var(--color-danger); padding: 12px; border-radius: 0 8px 8px 0; margin-top: 16px;">
            <strong style="color: #fca5a5;">🚨 REGULAMENTO ANTI-VACILO (PDCA DE FOCO):</strong><br>
            É estritamente proibido sair da aba, minimizar a janela ou usar "Ctrl+V". Cada infração detectada pelo sistema gera um <strong>Vacilo (−1,0 ponto)</strong> direto na média final!
          </div>
        </div>

        <input type="text" id="input-student-name" class="input-text" placeholder="Digite seu Nome Completo..." autocomplete="off">
        <button class="btn" onclick="startJourney()">🚀 INICIAR AVALIAÇÃO LOGÍSTICA</button>
      </div>
    </div>

    <!-- TELA B: MAPA DA TRILHA -->
    <div id="screen-map" class="screen">
      <div class="glass-card" style="text-align: center; padding: 24px; margin-bottom: 20px;">
        <h2 style="margin-bottom: 8px;">🗺️ Mapa Operacional</h2>
        <p style="color: var(--color-text-muted); font-size: 0.95rem;">Conclua as estações na ordem para liberar seu boletim</p>
      </div>
      <div id="trail-map-container" class="trail-map"></div>
    </div>

    <!-- TELA C: LIÇÃO -->
    <div id="screen-lesson" class="screen">
      <div class="step-progress-bar">
        <div id="step-dot-0" class="step-dot"></div>
        <div id="step-dot-1" class="step-dot"></div>
        <div id="step-dot-2" class="step-dot"></div>
      </div>
      <div class="glass-card">
        <div id="lesson-step-content"></div>
      </div>
    </div>

    <!-- TELA D: RELATÓRIO FINAL / BOLETIM IMPRESSO -->
    <div id="screen-final" class="screen">
      <div class="glass-card printable-area">
        
        <!-- Cabeçalho (Foco na Impressão) -->
        <div class="print-header">
          <h2 style="font-size: 1.8rem; color: var(--color-secondary); margin-bottom: 8px; text-transform: uppercase;">Boletim de Desempenho Técnico</h2>
          <p style="color: var(--color-text-muted); font-size: 1.1rem;">Componente Curricular: Gestão e Controle de Estoques</p>
        </div>

        <!-- Resumo Geral -->
        <div class="print-summary" style="background: rgba(0,0,0,0.25); border-radius: var(--border-radius-md); text-align: left; margin-bottom: 24px;">
          <table style="width: 100%; border-collapse: collapse; font-size: 1.05rem;">
            <tr>
              <td style="padding: 8px 0;"><strong>Nome do Estudante:</strong></td>
              <td style="text-align: right;"><span id="final-student-name" style="font-weight: bold;">-</span></td>
            </tr>
            <tr>
              <td style="padding: 8px 0;"><strong>Tempo Total de Resolução:</strong></td>
              <td style="text-align: right;"><span id="final-time">-</span></td>
            </tr>
            <tr>
              <td style="padding: 8px 0;"><strong>Questões Objetivas (Quizzes):</strong></td>
              <td style="text-align: right;"><span id="final-quizzes">-</span> de 4 certas</td>
            </tr>
            <tr>
              <td style="padding: 8px 0;"><strong>Nota Bruta de Conteúdo:</strong></td>
              <td style="text-align: right;"><span id="final-raw-score">-</span> / 10,0</td>
            </tr>
            <tr style="color: var(--color-danger); border-bottom: 1px solid var(--glass-border);">
              <td style="padding: 8px 0;"><strong>Penalidades (Falhas de Foco/Vacilos):</strong></td>
              <td style="text-align: right;">−<span id="final-vacilos">-</span>,0 pt(s)</td>
            </tr>
            <tr>
              <td style="padding: 16px 0 8px 0; font-size: 1.4rem; color: var(--color-accent);"><strong>MÉDIA FINAL VALIDADA:</strong></td>
              <td style="text-align: right; padding: 16px 0 8px 0; font-size: 1.4rem; color: var(--color-accent);"><strong><span id="final-grade">-</span> / 10,0</strong></td>
            </tr>
          </table>
        </div>

        <div id="final-feedback-msg" class="highlight-box" style="text-align: left; margin-bottom: 32px;"></div>

        <!-- CONTAINER DO RELATÓRIO DETALHADO (Injetado via JS) -->
        <div id="final-detailed-report"></div>

        <button class="btn" onclick="window.print()" style="background: linear-gradient(135deg, var(--color-success), var(--color-secondary)); margin-top: 20px;">
          🖨️ EXPORTAR BOLETIM DETALHADO (PDF)
        </button>
      </div>
    </div>

  </div>

  <div id="toast-container"></div>

  <div id="teacher-modal" class="modal-overlay" style="display: none;">
    <div class="glass-card" style="max-width: 400px; width: 100%;">
      <h3 style="margin-bottom: 16px; color: var(--color-accent);">🔒 Reset de Dispositivo</h3>
      <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 20px;">
        Insira a credencial do professor para limpar os dados deste aluno e liberar o navegador para a próxima turma.
      </p>
      <input type="password" id="teacher-password" class="input-text" placeholder="Senha Administrativa">
      <div style="display: flex; gap: 12px;">
        <button class="btn" onclick="confirmTeacherReset()" style="background: var(--color-danger);">LIMPAR DADOS</button>
        <button class="btn" onclick="closeTeacherModal()" style="background: rgba(255,255,255,0.1); color: white;">FECHAR</button>
      </div>
    </div>
  </div>

  <div id="confetti-container" class="confetti-container"></div>

  <script>
    /* --------------------------------------------------------------------------
       A. BANCO DE DADOS DAS ESTAÇÕES (REDUZIDO PARA 2 ESTAÇÕES FOCADAS)
       -------------------------------------------------------------------------- */
    const STATIONS_DATA = [
      {
        id: 1,
        title: "Previsão de Demanda e Sazonalidade",
        icon: "📈",
        narrative: `
          Olá, <strong>{NOME}</strong>! Você assumiu a coordenação de planejamento em uma grande confecção de vestuário. A diretoria precisa projetar a produção de peças para o próximo semestre e evitar dois gargalos clássicos da logística: a <em>ruptura</em> (falta de produto na prateleira) e o <em>excesso de estoque</em> (dinheiro parado e custos de armazenagem).
          <br><br>
          Analisando os históricos de vendas, você nota que a demanda sofre variações fortes ao longo dos meses. Em períodos quentes, alguns modelos vendem o triplo; no inverno, caem drasticamente. Para o próximo ciclo, a meta macro é absorver um aumento projetado de <strong>10% na demanda global</strong>.
          <div class="highlight-box">
            <strong>Você no comando, {NOME}:</strong> Como líder logístico, sua missão é aplicar o conceito de sazonalidade sobre a demanda histórica para prever com exatidão a quantidade de insumos, garantindo compras eficientes e fluxo produtivo constante.
          </div>
        `,
        quizzes: [
          {
            question: "O que caracteriza a sazonalidade na análise da previsão de demanda logística?",
            options: [
              "Flutuações imprevisíveis causadas por falhas operacionais sistêmicas.",
              "Padrões de vendas cíclicos que se repetem em períodos específicos do ano (ex: picos no verão).",
              "A manutenção estática das vendas durante todos os meses, independente do clima ou data.",
              "A decisão arbitrária de suspender a produção de itens essenciais."
            ],
            correct: 1,
            explanation: "Sazonalidade refere-se a padrões cíclicos e repetitivos nas vendas, como o aumento natural na venda de sorvetes ou roupas de banho no verão."
          },
          {
            question: "Se a previsão de demanda indica um aumento projetado nas vendas futuras, qual deve ser a decisão imediata da gestão de estoques?",
            options: [
              "Manter o planejamento de compras inalterado para economizar recursos.",
              "Reduzir drasticamente o estoque de segurança.",
              "Aumentar o planejamento de compras de insumos e adequar a capacidade do armazém.",
              "Suspender o recebimento de novos materiais temporariamente."
            ],
            correct: 2,
            explanation: "Se a previsão aponta crescimento, a cadeia de suprimentos deve reagir aumentando o planejamento de compras para evitar a ruptura de estoque no cliente final."
          }
        ],
        writtenPrompt: "Reflita e redija: Quais são os impactos operacionais e financeiros diretos para a empresa se ocorrerem erros graves na previsão de demanda e no cálculo de sazonalidade dos produtos?"
      },
      {
        id: 2,
        title: "Estoque Mínimo e de Segurança",
        icon: "🛡️",
        narrative: `
          Excelente leitura de cenário, <strong>{NOME}</strong>! Com a demanda projetada, enfrentamos a realidade da rua: os fornecedores de matéria-prima sofrem com o trânsito da região e frequentemente atrasam as entregas (Lead Time variável). Contudo, a linha de produção não pode parar de jeito nenhum.
          <br><br>
          Para blindar a operação contra o desabastecimento, você precisa dimensionar o <strong>Estoque de Segurança (ES)</strong>, também chamado de Estoque Mínimo. Esse estoque é o 'amortecedor' que absorve imprevistos logísticos e flutuações repentinas no consumo diário.
          <div class="highlight-box">
            <strong>Você no comando, {NOME}:</strong> Um estoque de segurança muito alto blinda a operação, mas imobiliza capital financeiro que poderia ser investido. Seu desafio é explicar tecnicamente o equilíbrio entre nível de serviço e custo financeiro.
          </div>
        `,
        quizzes: [
          {
            question: "Qual é a função primária do Estoque de Segurança na gestão de um almoxarifado?",
            options: [
              "Servir exclusivamente como vitrine para clientes atacadistas.",
              "Garantir a ocupação total da capacidade cúbica do galpão logístico.",
              "Eliminar a necessidade de emitir novos pedidos de compra para o setor de suprimentos.",
              "Atuar como reserva estratégica para proteger a empresa contra atrasos de fornecedores e picos de demanda."
            ],
            correct: 3,
            explanation: "O estoque de segurança é o 'colchão' que impede a linha de montagem de parar caso o fornecedor atrase ou o consumo dispare fora do previsto."
          },
          {
            question: "Qual o principal risco financeiro associado à manutenção de um Estoque de Segurança excessivamente alto?",
            options: [
              "Aumento de capital imobilizado, maiores custos de armazenagem e risco de obsolescência.",
              "Aumento instantâneo no volume de vendas da empresa.",
              "Redução automática dos prazos de entrega dos fornecedores.",
              "Eliminação da necessidade de inventários cíclicos no setor."
            ],
            correct: 0,
            explanation: "Manter muito estoque significa 'dinheiro parado', ocupando espaço físico caro e correndo o risco de o material estragar ou sair de linha (obsolescência)."
          }
        ],
        writtenPrompt: "Descreva tecnicamente: Como a gestão correta do Estoque de Segurança auxilia a empresa a manter a eficiência na linha de produção sem sufocar o fluxo de caixa corporativo?"
      }
    ];

    const VACILO_MESSAGES = [
      "🚨 Opa, {NOME}! Perdeu o foco e mudou de aba? O sistema logístico registrou! (−1,0 pt)",
      "⚠️ Eita, {NOME}! Tentou colar o texto? Aqui operamos com autenticidade! (−1,0 pt)",
      "👀 Cadê você, {NOME}? Minimizar a tela no meio da operação não dá! (−1,0 pt)",
      "🚫 Vacilo detectado! Tentativa de 'Ctrl+V' bloqueada pelo ERP educacional. (−1,0 pt)"
    ];

    /* --------------------------------------------------------------------------
       B. ESTADO & LOCALSTORAGE
       -------------------------------------------------------------------------- */
    let state = {
      studentName: "", started: false, currentStationIdx: 0, currentStepIdx: 0,
      vacilos: 0, timerSeconds: 0, quizAnswers: {}, quizCorrect: {},
      writtenAnswers: {}, completedStations: [], finished: false
    };

    let timerInterval = null;

    function saveState() {
      try { localStorage.setItem("trilha_logistica_v2", JSON.stringify(state)); } 
      catch (e) { console.warn("Erro no localStorage", e); }
    }

    function loadState() {
      try {
        const saved = localStorage.getItem("trilha_logistica_v2");
        if (saved) { state = JSON.parse(saved); return true; }
      } catch (e) { console.warn("Erro ao carregar", e); }
      return false;
    }

    /* --------------------------------------------------------------------------
       C. INICIALIZAÇÃO & FLUXO
       -------------------------------------------------------------------------- */
    window.addEventListener("DOMContentLoaded", () => {
      if (loadState() && state.started) {
        initUI();
        state.finished ? (showScreen("screen-final"), renderFinalScreen()) : (showScreen("screen-map"), renderMap());
      } else {
        showScreen("screen-welcome");
      }
      setupAntiCheatListeners();
    });

    function showScreen(screenId) {
      document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
      document.getElementById(screenId).classList.add("active");
      document.getElementById("hud").style.display = screenId === "screen-welcome" ? "none" : "flex";
    }

    function startJourney() {
      const nameInput = document.getElementById("input-student-name").value.trim();
      if (!nameInput) return alert("Por favor, identifique-se para iniciar.");
      state.studentName = nameInput; state.started = true;
      saveState(); initUI(); showScreen("screen-map"); renderMap();
    }

    function initUI() {
      document.getElementById("hud-user-name").innerText = state.studentName;
      updateHUD(); startTimer();
    }

    function updateHUD() {
      document.getElementById("hud-vacilos-count").innerText = state.vacilos;
      const m = String(Math.floor(state.timerSeconds / 60)).padStart(2, '0');
      const s = String(state.timerSeconds % 60).padStart(2, '0');
      document.getElementById("hud-timer").innerText = `${m}:${s}`;
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        if (state.started && !state.finished) {
          state.timerSeconds++; updateHUD();
          if (state.timerSeconds % 5 === 0) saveState();
        }
      }, 1000);
    }

    /* --------------------------------------------------------------------------
       D. MAPA & LIÇÃO
       -------------------------------------------------------------------------- */
    function renderMap() {
      const container = document.getElementById("trail-map-container");
      container.innerHTML = "";
      STATIONS_DATA.forEach((station, idx) => {
        const isCompleted = state.completedStations.includes(idx);
        const isCurrent = idx === state.completedStations.length && !isCompleted;
        const isLocked = idx > state.completedStations.length;

        const nodeWrapper = document.createElement("div");
        nodeWrapper.className = "node-wrapper";
        let btnClass = `node-btn ${isCompleted ? 'completed' : isCurrent ? 'current' : 'locked'}`;
        let btnIcon = isCompleted ? "✅" : isLocked ? "🔒" : station.icon;
        
        nodeWrapper.innerHTML = `
          <button class="${btnClass}" onclick="openStation(${idx})" ${isLocked ? 'disabled' : ''}>${btnIcon}</button>
          <div class="node-label">Estação ${station.id}</div>
        `;
        if (idx < STATIONS_DATA.length - 1) {
          nodeWrapper.innerHTML += `<div class="node-connector ${isCompleted ? 'active' : ''}"></div>`;
        }
        container.appendChild(nodeWrapper);
      });
    }

    function openStation(idx) {
      if (idx > state.completedStations.length) return;
      state.currentStationIdx = idx; state.currentStepIdx = 0; saveState();
      showScreen("screen-lesson"); renderLessonStep();
    }

    function renderLessonStep() {
      const station = STATIONS_DATA[state.currentStationIdx];
      const contentDiv = document.getElementById("lesson-step-content");

      for (let i = 0; i < 3; i++) {
        const dot = document.getElementById(`step-dot-${i}`);
        dot.className = "step-dot";
        if (i < state.currentStepIdx) dot.classList.add("completed");
        if (i === state.currentStepIdx) dot.classList.add("active");
      }

      if (state.currentStepIdx === 0) {
        const text = station.narrative.replace(/{NOME}/g, state.studentName);
        contentDiv.innerHTML = `
          <h3 style="color: var(--color-secondary); margin-bottom: 20px; font-size: 1.4rem;">${station.icon} ${station.title}</h3>
          <div class="narrative-box">${text}</div>
          <button class="btn" onclick="nextStep()">PROSSEGUIR PARA DESAFIOS ➡️</button>
        `;
      } 
      else if (state.currentStepIdx === 1) {
        let html = `<h3 style="color: var(--color-secondary); margin-bottom: 24px;">🧩 Desafios de Fixação</h3>`;
        station.quizzes.forEach((q, qIdx) => {
          const key = `${state.currentStationIdx}_${qIdx}`;
          const answered = state.quizAnswers.hasOwnProperty(key);
          const sel = state.quizAnswers[key];

          html += `<div style="margin-bottom: 32px;"><p class="quiz-question">${qIdx + 1}. ${q.question}</p><div class="quiz-options">`;
          q.options.forEach((opt, oIdx) => {
            let cls = "option-btn";
            if (answered) {
              if (oIdx === q.correct) cls += " correct";
              else if (oIdx === sel) cls += " incorrect";
            }
            html += `<button class="${cls}" onclick="selectQuiz(${qIdx}, ${oIdx})" ${answered ? 'disabled' : ''}>${String.fromCharCode(65 + oIdx)}) ${opt}</button>`;
          });
          html += `</div>`;
          if (answered) {
            const isCorr = state.quizCorrect[key];
            html += `<div class="feedback-box ${isCorr ? 'correct' : 'incorrect'}">
              <strong>${isCorr ? '✨ Correto!' : '❌ Incorreto!'}</strong><br>${q.explanation}</div>`;
          }
          html += `</div>`;
        });
        const allAns = station.quizzes.every((_, qIdx) => state.quizAnswers.hasOwnProperty(`${state.currentStationIdx}_${qIdx}`));
        html += `<button class="btn" onclick="nextStep()" ${allAns ? '' : 'disabled'}>IR PARA REDAÇÃO TÉCNICA ➡️</button>`;
        contentDiv.innerHTML = html;
      } 
      else if (state.currentStepIdx === 2) {
        const text = state.writtenAnswers[state.currentStationIdx] || "";
        const chars = text.length;
        const valid = chars >= 250;
        contentDiv.innerHTML = `
          <h3 style="color: var(--color-secondary); margin-bottom: 16px;">✍️ Relatório Técnico</h3>
          <p style="margin-bottom: 20px; font-size: 1.05rem; color: #e2e8f0; line-height: 1.6;">${station.writtenPrompt}</p>
          <textarea id="written-textarea" class="input-text" placeholder="Redija sua análise detalhada (mínimo de 250 caracteres)..." oninput="handleText(this)">${text}</textarea>
          <div id="char-counter" class="char-counter ${valid ? 'valid' : ''}">${chars} / 250 caracteres mínimos</div>
          <button class="btn" id="btn-finish-station" onclick="finishStation()" ${valid ? '' : 'disabled'}>REGISTRAR E CONCLUIR ESTAÇÃO ✅</button>
        `;
        setTimeout(() => setupAreaAntiPaste(document.getElementById("written-textarea")), 50);
      }
    }

    function selectQuiz(qIdx, oIdx) {
      const key = `${state.currentStationIdx}_${qIdx}`;
      if (state.quizAnswers.hasOwnProperty(key)) return;
      state.quizAnswers[key] = oIdx;
      state.quizCorrect[key] = (oIdx === STATIONS_DATA[state.currentStationIdx].quizzes[qIdx].correct);
      saveState(); renderLessonStep();
    }

    function handleText(ta) {
      const text = ta.value;
      state.writtenAnswers[state.currentStationIdx] = text;
      const chars = text.length;
      const counter = document.getElementById("char-counter");
      const btn = document.getElementById("btn-finish-station");
      counter.innerText = `${chars} / 250 caracteres mínimos`;
      if (chars >= 250) { counter.classList.add("valid"); btn.disabled = false; } 
      else { counter.classList.remove("valid"); btn.disabled = true; }
      saveState();
    }

    function nextStep() { state.currentStepIdx++; saveState(); renderLessonStep(); }

    function finishStation() {
      if (!state.completedStations.includes(state.currentStationIdx)) state.completedStations.push(state.currentStationIdx);
      saveState();
      if (state.completedStations.length === STATIONS_DATA.length) {
        state.finished = true; saveState(); showScreen("screen-final"); renderFinalScreen();
      } else {
        showScreen("screen-map"); renderMap();
      }
    }

    /* --------------------------------------------------------------------------
       E. GERAÇÃO DO RELATÓRIO FINAL DETALHADO (TELA E PDF)
       -------------------------------------------------------------------------- */
    function calculateGrades() {
      let totalQ = 0, correctQ = 0;
      STATIONS_DATA.forEach((st, sIdx) => {
        st.quizzes.forEach((_, qIdx) => {
          totalQ++;
          if (state.quizCorrect[`${sIdx}_${qIdx}`]) correctQ++;
        });
      });
      const writtenQ = Object.keys(state.writtenAnswers).filter(k => state.writtenAnswers[k].length >= 250).length;
      
      const quizScore = (correctQ / totalQ) * 5.0;
      const writtenScore = (writtenQ / STATIONS_DATA.length) * 5.0;
      const rawScore = quizScore + writtenScore;
      const finalGrade = Math.max(0, rawScore - state.vacilos);

      return { correctQ, totalQ, rawScore: rawScore.toFixed(1), finalGrade: finalGrade.toFixed(1) };
    }

    function renderFinalScreen() {
      const stats = calculateGrades();

      // Dados do Resumo
      document.getElementById("final-student-name").innerText = state.studentName;
      const m = String(Math.floor(state.timerSeconds / 60)).padStart(2, '0');
      const s = String(state.timerSeconds % 60).padStart(2, '0');
      document.getElementById("final-time").innerText = `${m} minutos e ${s} segundos`;
      document.getElementById("final-quizzes").innerText = stats.correctQ;
      document.getElementById("final-raw-score").innerText = stats.rawScore;
      document.getElementById("final-vacilos").innerText = state.vacilos;
      document.getElementById("final-grade").innerText = stats.finalGrade;

      // Mensagem de Feedback
      const fNum = parseFloat(stats.finalGrade);
      const feedBox = document.getElementById("final-feedback-msg");
      if (fNum >= 8.0) {
        feedBox.innerHTML = `<strong>🏆 EXCELÊNCIA OPERACIONAL!</strong><br>Ótimo domínio técnico dos conceitos de Demanda e Estoque. Você demonstrou visão crítica e foco impecável.`;
        triggerConfetti();
      } else if (fNum >= 5.0) {
        feedBox.innerHTML = `<strong>👍 DESEMPENHO REGULAR!</strong><br>Você compreendeu as bases do planejamento, mas atente-se aos erros conceituais ou penalidades por falta de foco.`;
      } else {
        feedBox.innerHTML = `<strong>⚠️ ALERTA DE REVISÃO!</strong><br>A média técnica não foi atingida. É crucial retornar ao material teórico sobre parâmetros de ressuprimento e revisar seus apontamentos.`;
      }

      // ==========================================
      // GERAÇÃO DO RELATÓRIO DETALHADO (DOM E PDF)
      // ==========================================
      let reportHTML = `<div style="margin-top: 40px;">`;
      reportHTML += `<h3 style="color: var(--color-primary); border-bottom: 2px solid var(--glass-border); padding-bottom: 10px; margin-bottom: 24px; text-transform: uppercase;">Detalhamento Analítico das Respostas</h3>`;

      STATIONS_DATA.forEach((station, sIdx) => {
        reportHTML += `<div class="detailed-report-section">`;
        reportHTML += `<h4 style="color: var(--color-secondary); margin-bottom: 16px; font-size: 1.2rem;">Estação ${station.id}: ${station.title}</h4>`;

        // Iterando sobre os Quizzes
        reportHTML += `<h5 style="color: var(--color-text-muted); margin-bottom: 12px; font-size: 1rem;">▶️ Apuração dos Desafios (Quizzes)</h5>`;
        station.quizzes.forEach((q, qIdx) => {
          const key = `${sIdx}_${qIdx}`;
          const isCorrect = state.quizCorrect[key];
          const studentAnsIdx = state.quizAnswers[key];
          const studentAnsText = studentAnsIdx !== undefined ? q.options[studentAnsIdx] : "Não respondido";
          const correctAnsText = q.options[q.correct];

          const colorClass = isCorrect ? 'print-correct' : 'print-incorrect';
          const icon = isCorrect ? '✅ Acertou' : '❌ Errou';
          const borderColor = isCorrect ? '#10b981' : '#ef4444';

          reportHTML += `
            <div style="margin-bottom: 16px; padding: 12px 16px; background: rgba(0,0,0,0.15); border-left: 4px solid ${borderColor}; border-radius: 4px;">
              <p style="margin-bottom: 8px; font-weight: bold; font-size: 0.95rem;">Q${qIdx + 1}: ${q.question}</p>
              <p style="margin-bottom: 4px; font-size: 0.9rem;">
                <strong>Resposta do Aluno:</strong> <span class="${colorClass}">${studentAnsText} (${icon})</span>
              </p>
          `;
          if (!isCorrect) {
            reportHTML += `<p style="font-size: 0.9rem; color: #a1a1aa; margin-top: 6px;"><strong>Gabarito Oficial:</strong> ${correctAnsText}</p>`;
          }
          reportHTML += `</div>`;
        });

        // Relatório da Redação
        reportHTML += `<h5 style="color: var(--color-text-muted); margin-top: 24px; margin-bottom: 12px; font-size: 1rem;">▶️ Apuração do Relatório Técnico (Redação)</h5>`;
        reportHTML += `<p style="font-size: 0.85rem; margin-bottom: 8px;"><strong>Comando solicitado:</strong> <em>${station.writtenPrompt}</em></p>`;
        
        const writtenText = state.writtenAnswers[sIdx] || "Nenhum texto registrado.";
        reportHTML += `<div class="print-written-box">${writtenText}</div>`;

        reportHTML += `</div>`; // Fim da section da estação
      });

      reportHTML += `</div>`;
      document.getElementById("final-detailed-report").innerHTML = reportHTML;
    }

    /* --------------------------------------------------------------------------
       F. ANTI-FRAUDE E UTILITÁRIOS
       -------------------------------------------------------------------------- */
    function triggerVacilo(msgTemplate) {
      if (!state.started || state.finished) return;
      state.vacilos++; updateHUD(); saveState();
      showToast(msgTemplate.replace(/{NOME}/g, state.studentName || "Estudante"));
    }

    function showToast(msg) {
      const container = document.getElementById("toast-container");
      const t = document.createElement("div"); t.className = "toast"; t.innerText = msg;
      container.appendChild(t);
      setTimeout(() => { t.style.opacity = "0"; t.style.transition = "opacity 0.5s"; setTimeout(() => t.remove(), 500); }, 4500);
    }

    function setupAntiCheatListeners() {
      document.addEventListener("visibilitychange", () => {
        if (document.hidden && state.started && !state.finished) {
          triggerVacilo(VACILO_MESSAGES[Math.floor(Math.random() * VACILO_MESSAGES.length)]);
        }
      });
    }

    function setupAreaAntiPaste(ta) {
      ta.addEventListener("paste", e => { e.preventDefault(); triggerVacilo("⚠️ Eita, {NOME}! Colar textos é proibido! Escreva com suas palavras. (−1,0 pt)"); });
      ta.addEventListener("drop", e => { e.preventDefault(); triggerVacilo("⚠️ Arrastar textos é bloqueado! (−1,0 pt)"); });
      ta.addEventListener("keydown", e => {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'v' || e.key === 'V')) {
          e.preventDefault(); triggerVacilo("🚫 Atalho Ctrl+V bloqueado pelo sistema. (−1,0 pt)");
        }
      });
    }

    function openTeacherModal() { document.getElementById("teacher-modal").style.display = "flex"; document.getElementById("teacher-password").value = ""; }
    function closeTeacherModal() { document.getElementById("teacher-modal").style.display = "none"; }
    function confirmTeacherReset() {
      if (document.getElementById("teacher-password").value === "PROFESSOR") {
        try { localStorage.removeItem("trilha_logistica_v2"); } catch (e) {}
        alert("Dados locais removidos. Navegador liberado."); location.reload();
      } else alert("Credencial incorreta.");
    }

    function triggerConfetti() {
      const c = document.getElementById("confetti-container"); c.innerHTML = "";
      const emojis = ["📦", "📈", "⭐", "🚀", "✅"];
      for (let i = 0; i < 40; i++) {
        const d = document.createElement("div"); d.className = "confetti"; d.innerText = emojis[Math.floor(Math.random() * emojis.length)];
        d.style.left = Math.random() * 100 + "%"; d.style.animationDelay = Math.random() * 2 + "s"; d.style.animationDuration = (2.5 + Math.random() * 2) + "s";
        c.appendChild(d);
      }
    }
  </script>
</body>
</html>
